
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>O² | متجر البراويز واللوحات الفنية</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * {
      font-family: 'Cairo', sans-serif;
    }
    html {
      scroll-behavior: smooth;
    }
    /* Custom scrollbar for clean gallery look */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #f5f5f4;
    }
    ::-webkit-scrollbar-thumb {
      background: #d6d3d1;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #a8a29e;
    }
    .frame-shadow {
      box-shadow: 0 12px 30px -8px rgba(0, 0, 0, 0.12), 0 4px 10px -4px rgba(0, 0, 0, 0.06);
    }
  </style>
</head>
<body class="bg-stone-50 text-stone-900 antialiased selection:bg-amber-900 selection:text-white flex flex-col min-h-screen">

  <!-- Toast Notification Banner -->
  <div id="toast-container" class="fixed top-20 left-1/2 -translate-x-1/2 z-50 pointer-events-none transition-all duration-300 opacity-0 -translate-y-3">
    <div id="toast-message" class="bg-stone-900 text-white px-5 py-3 rounded-2xl shadow-xl text-sm font-medium flex items-center gap-2 border border-stone-700">
      <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
      <span id="toast-text">تمت الإضافة إلى السلة</span>
    </div>
  </div>

  <!-- Sticky Header -->
  <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-stone-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 py-3 flex items-center justify-between gap-4">
      <!-- Brand Logo -->
      <a href="#" class="flex items-center gap-3 group">
        <div class="w-11 h-11 rounded-2xl bg-stone-900 text-white flex items-center justify-center font-extrabold text-xl tracking-tight shadow-sm group-hover:bg-amber-900 transition-colors">
          O<sup class="text-xs font-bold text-amber-400 mr-0.5">2</sup>
        </div>
        <div class="flex flex-col">
          <span class="font-extrabold text-lg leading-none text-stone-900 tracking-tight">O² Frames</span>
          <span class="text-[11px] text-stone-500 mt-1">فن التأطير والديكور العصري</span>
        </div>
      </a>

      <!-- Search Bar (Desktop) -->
      <div class="hidden md:flex flex-1 max-w-md mx-4">
        <div class="relative w-full">
          <input
            type="text"
            id="search-input-desktop"
            placeholder="ابحث عن برواز، مقاس، أو تصميم..."
            class="w-full bg-stone-100/80 border border-stone-200 rounded-2xl py-2.5 pr-10 pl-4 text-sm text-stone-800 placeholder-stone-400 focus:outline-none focus:bg-white focus:border-stone-900 transition-all"
          />
          <svg class="w-4 h-4 text-stone-400 absolute right-3.5 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>

      <!-- Actions: Cart Button -->
      <div class="flex items-center gap-2 sm:gap-3">
        <a href="#catalog" class="hidden sm:inline-flex text-sm font-semibold text-stone-600 hover:text-stone-900 px-3 py-2 rounded-xl transition-colors">
          المتجر
        </a>
        <button
          id="open-cart-btn"
          class="relative inline-flex items-center gap-2.5 bg-stone-900 hover:bg-stone-800 text-white px-4 py-2.5 rounded-2xl text-sm font-semibold shadow-sm transition-all active:scale-95"
          aria-label="سلة المشتريات"
        >
          <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span>السلة</span>
          <span id="cart-badge" class="bg-amber-500 text-stone-950 text-xs font-extrabold px-2 py-0.5 rounded-full min-w-[22px] text-center">
            0
          </span>
        </button>
      </div>
    </div>

    <!-- Search Bar (Mobile) -->
    <div class="md:hidden px-4 pb-3">
      <div class="relative w-full">
        <input
          type="text"
          id="search-input-mobile"
          placeholder="ابحث عن برواز أو لوحة..."
          class="w-full bg-stone-100 border border-stone-200 rounded-xl py-2 pr-9 pl-4 text-sm text-stone-800 placeholder-stone-400 focus:outline-none focus:bg-white focus:border-stone-900"
        />
        <svg class="w-4 h-4 text-stone-400 absolute right-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-b from-stone-100 via-stone-50 to-stone-50 border-b border-stone-200/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <!-- Hero Text -->
        <div class="lg:col-span-7 text-center lg:text-right space-y-6">
          <div class="inline-flex items-center gap-2 bg-white border border-stone-200 px-4 py-1.5 rounded-full text-xs font-bold text-stone-700 shadow-xs">
            <span class="w-2 h-2 rounded-full bg-amber-600"></span>
            <span>تشكيلة O² الجديدة للديكور الداخلي</span>
          </div>
          <h1 class="text-3xl sm:text-5xl font-extrabold text-stone-900 leading-tight">
            حوّل جدران منزلك إلى <span class="text-amber-800">معرض فني</span> يعكس ذوقك
          </h1>
          <p class="text-stone-600 text-base sm:text-lg max-w-2xl mx-auto lg:mx-0 leading-relaxed">
            براويز ولوحات فنية مصممة بعناية فائقة من خامات خشبية ومعدنية عالية الجودة، مع طباعة فائقة الوضوح وتغليف آمن يصلك أينما كنت.
          </p>
          <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3 pt-2">
            <a href="#catalog" class="bg-stone-900 hover:bg-amber-900 text-white font-bold px-7 py-3.5 rounded-2xl shadow-md transition-all">
              تصفح البراويز الآن
            </a>
            <button onclick="openCart()" class="bg-white hover:bg-stone-100 text-stone-800 border border-stone-300 font-semibold px-6 py-3.5 rounded-2xl transition-all">
              مراجعة سلة المشتريات
            </button>
          </div>
          <!-- Trust Features -->
          <div class="grid grid-cols-3 gap-4 pt-6 border-t border-stone-200/80 max-w-lg mx-auto lg:mx-0 text-center lg:text-right">
            <div>
              <p class="font-extrabold text-stone-900 text-sm sm:text-base">خامات فاخرة</p>
              <p class="text-xs text-stone-500 mt-0.5">خشب طبيعي وأكريليك</p>
            </div>
            <div>
              <p class="font-extrabold text-stone-900 text-sm sm:text-base">طباعة HD</p>
              <p class="text-xs text-stone-500 mt-0.5">ألوان ثابتة لا تبهت</p>
            </div>
            <div>
              <p class="font-extrabold text-stone-900 text-sm sm:text-base">طلب سريع</p>
              <p class="text-xs text-stone-500 mt-0.5">تأكيد فوري عبر واتساب</p>
            </div>
          </div>
        </div>

        <!-- Hero Visual Showcase -->
        <div class="lg:col-span-5">
          <div class="bg-white p-5 sm:p-6 rounded-3xl border border-stone-200/80 frame-shadow">
            <div class="grid grid-cols-2 gap-4">
              <div class="space-y-4">
                <div class="rounded-2xl overflow-hidden border-8 border-stone-900 shadow-md aspect-[3/4] bg-stone-100">
                  <img
                    src="https://images.unsplash.com/photo-1513519245088-0e12902e5a38?auto=format&fit=crop&w=600&q=80"
                    onerror="this.src='https://placehold.co/400x530/292524/fafaf9?text=O%C2%B2+Modern+Art'"
                    alt="برواز مودرن O²"
                    class="w-full h-full object-cover"
                  />
                </div>
                <div class="bg-stone-100 rounded-2xl p-3.5 text-center">
                  <span class="text-xs font-bold text-stone-500 block">أكثر مبيعاً</span>
                  <span class="text-sm font-extrabold text-stone-900">مجموعات الجدران الكاملة</span>
                </div>
              </div>
              <div class="space-y-4 pt-6">
                <div class="bg-amber-900 text-white rounded-2xl p-4 text-center shadow-sm">
                  <span class="text-2xl font-extrabold block">O²</span>
                  <span class="text-xs text-amber-200">جودة تليق بمساحتك</span>
                </div>
                <div class="rounded-2xl overflow-hidden border-8 border-amber-800/80 shadow-md aspect-[3/4] bg-stone-100">
                  <img
                    src="https://images.unsplash.com/photo-1582582621959-48d27397dc69?auto=format&fit=crop&w=600&q=80"
                    onerror="this.src='https://placehold.co/400x530/78350f/fafaf9?text=O%C2%B2+Classic+Wood'"
                    alt="برواز خشب طبيعي O²"
                    class="w-full h-full object-cover"
                  />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Catalog Section -->
  <main id="catalog" class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Section Header & Filters -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
      <div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-stone-900">تشكيلة البراويز المتاحة</h2>
        <p class="text-sm text-stone-500 mt-1">اختر البرواز المناسب لمساحتك وأضفه إلى السلة لإتمام الطلب</p>
      </div>

      <!-- Category Pills -->
      <div id="category-filters" class="flex items-center gap-2 overflow-x-auto pb-2 md:pb-0">
        <button data-category="الكل" class="category-btn active bg-stone-900 text-white px-4 py-2 rounded-xl text-sm font-bold whitespace-nowrap transition-all">
          الكل
        </button>
        <button data-category="براويز مودرن" class="category-btn bg-white text-stone-700 border border-stone-200 hover:border-stone-400 px-4 py-2 rounded-xl text-sm font-semibold whitespace-nowrap transition-all">
          براويز مودرن
        </button>
        <button data-category="لوحات فنية" class="category-btn bg-white text-stone-700 border border-stone-200 hover:border-stone-400 px-4 py-2 rounded-xl text-sm font-semibold whitespace-nowrap transition-all">
          لوحات فنية
        </button>
        <button data-category="مجموعات حائط" class="category-btn bg-white text-stone-700 border border-stone-200 hover:border-stone-400 px-4 py-2 rounded-xl text-sm font-semibold whitespace-nowrap transition-all">
          مجموعات حائط
        </button>
        <button data-category="براويز خشب" class="category-btn bg-white text-stone-700 border border-stone-200 hover:border-stone-400 px-4 py-2 rounded-xl text-sm font-semibold whitespace-nowrap transition-all">
          براويز خشب
        </button>
      </div>
    </div>

    <!-- Products Count & Sort -->
    <div class="flex items-center justify-between text-xs text-stone-500 mb-6 pb-3 border-b border-stone-200/70">
      <span id="products-count-label">عرض 0 منتج</span>
      <div class="flex items-center gap-2">
        <label for="sort-select">ترتيب حسب:</label>
        <select id="sort-select" class="bg-white border border-stone-200 rounded-lg px-2.5 py-1.5 text-stone-800 font-semibold focus:outline-none focus:border-stone-900">
          <option value="newest">الأحدث</option>
          <option value="price-asc">السعر: من الأقل للأعلى</option>
          <option value="price-desc">السعر: من الأعلى للأقل</option>
        </select>
      </div>
    </div>

    <!-- Products Grid -->
    <div id="products-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      <!-- Dynamic Product Cards Rendered Here -->
    </div>

    <!-- Empty Search State -->
    <div id="empty-state" class="hidden text-center py-16 bg-white rounded-3xl border border-stone-200/80">
      <div class="w-16 h-16 rounded-2xl bg-stone-100 text-stone-400 flex items-center justify-center mx-auto mb-4">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <h3 class="text-lg font-bold text-stone-800">لا توجد منتجات مطابقة لبحثك</h3>
      <p class="text-sm text-stone-500 mt-1">جرّب البحث بكلمة أخرى أو تصفح جميع الأقسام</p>
      <button onclick="resetFilters()" class="mt-4 bg-stone-900 text-white text-sm font-semibold px-5 py-2.5 rounded-xl hover:bg-stone-800 transition-colors">
        عرض كل البراويز
      </button>
    </div>
  </main>

  <!-- Organized Footer with Subtle Hidden Admin Trigger at the Very Bottom -->
  <footer class="bg-stone-900 text-stone-300 mt-16 border-t border-stone-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pb-8 border-b border-stone-800">
        <!-- Brand Info -->
        <div class="space-y-3">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-white text-stone-900 flex items-center justify-center font-extrabold text-lg">
              O<sup class="text-xs font-bold text-amber-600 mr-0.5">2</sup>
            </div>
            <span class="font-extrabold text-xl text-white">O² Frames</span>
          </div>
          <p class="text-sm text-stone-400 leading-relaxed max-w-sm">
            متجر متخصص في تصميم وتنفيذ أرقى البراويز واللوحات الجدارية العصرية بجودة استثنائية تناسب المنازل والمكاتب.
          </p>
        </div>

        <!-- Quick Links -->
        <div class="space-y-3">
          <h4 class="text-white font-bold text-sm">روابط سريعة</h4>
          <ul class="space-y-2 text-sm text-stone-400">
            <li><a href="#catalog" onclick="filterByCategory('الكل')" class="hover:text-white transition-colors">جميع البراويز</a></li>
            <li><a href="#catalog" onclick="filterByCategory('براويز مودرن')" class="hover:text-white transition-colors">براويز مودرن</a></li>
            <li><a href="#catalog" onclick="filterByCategory('مجموعات حائط')" class="hover:text-white transition-colors">مجموعات الحائط</a></li>
            <li><button onclick="openCart()" class="hover:text-white transition-colors">سلة المشتريات</button></li>
          </ul>
        </div>

        <!-- Direct Contact -->
        <div class="space-y-3">
          <h4 class="text-white font-bold text-sm">تواصل معنا للطلبات الخاصة</h4>
          <p class="text-sm text-stone-400">نستقبل طلباتكم واستفساراتكم يومياً عبر واتساب:</p>
          <a
            href="https://wa.me/201036127871"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-emerald-600/20 text-emerald-400 border border-emerald-500/30 hover:bg-emerald-600 hover:text-white px-4 py-2 rounded-xl text-sm font-bold transition-all"
          >
            <span>واتساب: 01036127871</span>
          </a>
        </div>
      </div>

      <!-- Very Bottom Copyright & Discreet Hidden Word -->
      <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-stone-500">
        <p>© 2026 براند O² للبراويز واللوحات الفنية. جميع الحقوق محفوظة.</p>
        <!-- Unnoticeable / Blended Secret Trigger Word at the Very Bottom -->
        <div class="flex items-center gap-1 select-none">
          <span>صُنع بشغف لإبراز جمال</span>
          <span
            id="secret-admin-trigger"
            title=""
            class="text-stone-600/50 hover:text-stone-500/70 cursor-default transition-colors"
          >تفاصيلك</span>
        </div>
      </div>
    </div>
  </footer>

  <!-- Slide-Over Shopping Cart Drawer -->
  <div id="cart-drawer" class="fixed inset-0 z-50 hidden">
    <!-- Backdrop -->
    <div id="cart-backdrop" class="fixed inset-0 bg-stone-950/60 backdrop-blur-xs transition-opacity"></div>

    <!-- Drawer Panel -->
    <div class="fixed inset-y-0 left-0 max-w-md w-full bg-white shadow-2xl flex flex-col z-10">
      <!-- Drawer Header -->
      <div class="px-6 py-4 border-b border-stone-200 flex items-center justify-between bg-stone-50">
        <div class="flex items-center gap-2.5">
          <h3 class="text-lg font-extrabold text-stone-900">سلة المشتريات</h3>
          <span id="drawer-cart-count" class="bg-stone-900 text-white text-xs font-bold px-2.5 py-0.5 rounded-full">0</span>
        </div>
        <button id="close-cart-btn" class="p-2 rounded-xl text-stone-500 hover:text-stone-900 hover:bg-stone-200/70 transition-colors" aria-label="إغلاق">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Drawer Body (Scrollable) -->
      <div class="flex-1 overflow-y-auto p-6 space-y-6">
        <!-- Cart Items List -->
        <div id="cart-items-container" class="space-y-4">
          <!-- Cart items rendered dynamically -->
        </div>

        <!-- Empty Cart Message -->
        <div id="empty-cart-msg" class="text-center py-12 space-y-3">
          <div class="w-16 h-16 rounded-2xl bg-stone-100 text-stone-400 flex items-center justify-center mx-auto">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
          </div>
          <p class="font-bold text-stone-800">سلة المشتريات فارغة حالياً</p>
          <p class="text-xs text-stone-500">اختر البراويز التي تعجبك وأضفها للسلة لإرسال طلبك</p>
        </div>

        <!-- Customer Checkout Details Form (Visible when cart has items) -->
        <div id="checkout-form-section" class="hidden pt-4 border-t border-stone-200 space-y-4">
          <h4 class="font-extrabold text-sm text-stone-900 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-amber-600"></span>
            بيانات التوصيل وإتمام الطلب
          </h4>
          <div class="space-y-3">
            <div>
              <label class="block text-xs font-bold text-stone-700 mb-1">الاسم بالكامل *</label>
              <input
                type="text"
                id="customer-name"
                placeholder="مثال: أحمد محمد"
                class="w-full bg-stone-50 border border-stone-300 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:bg-white focus:border-stone-900"
              />
            </div>
            <div>
              <label class="block text-xs font-bold text-stone-700 mb-1">رقم الموبايل *</label>
              <input
                type="tel"
                id="customer-phone"
                placeholder="مثال: 010xxxxxxxx"
                class="w-full bg-stone-50 border border-stone-300 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:bg-white focus:border-stone-900"
              />
            </div>
            <div>
              <label class="block text-xs font-bold text-stone-700 mb-1">العنوان بالتفصيل (المحافظة / المنطقة / الشارع) *</label>
.